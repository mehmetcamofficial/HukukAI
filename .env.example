# HukukAI — Environment variable placeholders
# Copy to .env and fill with real values (never commit real secrets).

# Database (required for api-server and Drizzle)
# Example: postgres://user:password@localhost:5432/hukukai
DATABASE_URL=postgres://user:password@localhost:5432/hukukai

# Frontend dev server (optional — defaults: PORT=5173, BASE_PATH=/)
PORT=5173
BASE_PATH=/

# API server (optional)
# PORT is also used by api-server (defaults to 5000 if not overridden in code)
# LOG_LEVEL=info
LOG_LEVEL=info

# Node environment
NODE_ENV=development

# Replit (optional, only inside Replit)
# REPL_ID=

# Future: object storage, auth, AI provider (placeholders for later phases)
# S3_BUCKET=
# S3_REGION=
# AUTH_SECRET=
# OPENAI_API_KEY=
